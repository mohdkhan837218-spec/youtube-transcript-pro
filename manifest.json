{
  "manifest_version": 3,
  "name": "YouTube Transcript Pro — 1-Click Multi-Language & Timestamps",
  "version": "1.1.4",
  "minimum_chrome_version": "111",
  "description": "Extract YouTube video transcripts in Hindi, English, and 100+ languages in 1-click with exact timestamps and fast copy.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Transcript Pro",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/page-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-world.js",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "web-dashboard/*"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
